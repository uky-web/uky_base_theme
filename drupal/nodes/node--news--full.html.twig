{% extends 'node--full.html.twig' %}

{% block prefix %}
  {% set header_style = node.field_header_style.entity.type %}
  {% if header_style == 'full_width' %}
    {# Full-width hero #}
    {% set image_style = 'big_16x9' %}
  {% elseif header_style == 'full_width_3x1' %}
    {# Full-width hero (small) #}
    {% set image_style = 'big_3x1' %}
  {% elseif header_style == 'split_header' %}
    {# Split hero #}
    {% set image_style = 'medium_4x3' %}
  {% elseif header_style == 'split_header_16x9' %}
    {# Split hero (small) #}
    {% set image_style = 'medium_16x9' %}
  {% endif %}
  {% set styled_media = {
    '#theme':      'image_style',
    '#style_name': image_style,
    '#uri':        content.field_media[0]['#media'].field_media_image.entity.uri.value,
    '#alt':        content.field_media[0]['#media'].field_media_image[0].alt,
  } %}
  {% if header_style matches '{^split_header(_.+)?$}' %}
    {% include 'components-split-page-header' with {
      headline: content.field_headline_group,
      media: styled_media
    } %}
  {% elseif header_style matches '{^full_width(_.+)?$}' %}
    {% include 'components-hero-page-header' with {
      headline: content.field_headline_group,
      media: styled_media
    } %}
  {% else %}
    {% include 'components-text-page-header' with {
      slab_skin: 'slab--wildcat-white',
      headline: content.field_headline_group
    } %}
  {% endif %}

  {{ region.breadcrumb }}

  {% embed 'molecules-slab' %}
    {% block slab_content %}
      {% include 'molecules-content-meta' with {
        content_byline: content.field_byline,
        content_date: node.getCreatedTime(),
        all_day: true,
        content_taxonomy: content.field_categories|children,
      } %}
    {% endblock %}
  {% endembed %}
{% endblock %}

{% block content %}
  {% embed 'molecules-slab-2x1' %}
      {% block slab_content %}
        {% set catch_cache = content|render %}
        {{ content.body }}
      {% endblock %}
      {% block slab_sidebar %}
        {{ region.sidebar }}
      {% endblock %}
  {% endembed %}

  {% embed 'molecules-slab' %}
    {% block slab_content %}
      {{ content.field_paragraphs }}
    {% endblock %}
  {% endembed %}
{% endblock %}

{% block suffix %}
{% endblock %}
