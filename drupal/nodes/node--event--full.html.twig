{% extends 'node--full.html.twig' %}

{% block prefix %}
  {% set header_style = node.field_header_style.entity.type %}

  {# If the header style is not a string (usually if set to "none", it returns a reference), #}
  {# set it to a string for displaying no header #}
  {% if header_style is iterable %}
    {% set header_style = 'none' %}
  {% endif %}

  {% if header_style == 'full_width' %}
    {# Full-width hero #}
    {% set image_style = 'big_16x9' %}
  {% elseif header_style == 'full_width_3x1' %}
    {# Full-width hero (small) #}
    {% set image_style = 'big_3x1' %}
  {% elseif header_style == 'full_width_hero_overlay' %}
    {# Full-width hero (overlay) #}
    {% set image_style = 'big_3x1' %}
  {% elseif header_style == 'split_header' %}
    {# Split hero #}
    {% set image_style = 'medium_4x3' %}
  {% elseif header_style == 'split_header_16x9' %}
    {# Split hero (small) #}
    {% set image_style = 'medium_16x9' %}
  {% endif %}
  {% set styled_media = {
    '#theme':      'image_style',
    '#style_name': image_style,
    '#uri':        content.field_media[0]['#media'].field_media_image.entity.uri.value,
    '#alt':        content.field_media[0]['#media'].field_media_image[0].alt,
  } %}
  
{% if header_style == 'full_width_hero_overlay' %}
  {% include '@ukd8/components/home-hero/hero-page-header-overlay.html.twig' with {
    headline: content.field_headline_group,
    media: styled_media,
    slab_variant: "slab--wildcat-blue",
    hero_variant: "page-header--overlay"
  } %}
{% elseif header_style in ['full_width', 'full_width_3x1'] %}
  {% include 'components-hero-page-header' with {
    headline: content.field_headline_group,
    media: styled_media
  } %}
{% elseif header_style in ['split_header', 'split_header_16x9'] %}
  {% include 'components-split-page-header' with {
    headline: content.field_headline_group,
    media: styled_media
  } %}
{% else %}
  {% include 'components-text-page-header' with {
    headline: content.field_headline_group
  } %}
{% endif %}

  {{ region.breadcrumb }}

  {% set location = false %}
  {% if node.field_location|length %}
    {% set location = {
      title: node.field_location.entity.title.value,
      url: node.field_location.entity.field_link[0].url.toString(),
      address: node.field_location.entity.field_address.value,
    } %}
  {% endif %}

  {% embed 'molecules-slab' %}
    {% block slab_content %}
      {% include 'molecules-content-meta' with {
        content_location: location,
        content_date: node.field_dates.value,
        content_date_end: node.field_dates.end_value,
        all_day: node.field_all_day.value,
        content_taxonomy: content.field_categories|children,
      } %}
    {% endblock %}
  {% endembed %}
{% endblock %}

{% block content %}
  {% embed 'molecules-slab-2x1' %}
      {% block slab_content %}
        {{ content.body }}
      {% endblock %}
      {% block slab_sidebar %}
        {{ region.sidebar }}
      {% endblock %}
  {% endembed %}

  {% embed 'molecules-slab' %}
    {% block slab_content %}
      {{ content.field_paragraphs }}
    {% endblock %}
  {% endembed %}
{% endblock %}

{% block suffix %}
{% endblock %}
