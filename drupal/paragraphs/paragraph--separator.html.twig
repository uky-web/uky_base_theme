{{ attach_library('ukd8/separator') }}

{% set separator_type = content.field_separator_type.0['#markup']|lower|replace({' ': '_'})|default('linear_checkerboard') %}
{% set separator_color = content.field_separator_color.0['#markup']|lower|replace({' ': '_'})|default('blue') %}
{% set separator_width = content.field_separator_width.0['#markup']|lower|replace({' ': '_'})|default('content_width') %}
{% set separator_top_spacing = content.field_separator_top_spacing.0['#markup']|lower|replace({' ': '_'})|default('default') %}
{% set separator_bottom_spacing = content.field_separator_bottom_spacing.0['#markup']|lower|replace({' ': '_'})|default('default') %}

{% if separator_width == 'full_width' %}
  {% include '@components/separator/separator-full.twig' with {
    color: separator_color,
    type: separator_type,
    top_spacing: separator_top_spacing,
    bottom_spacing: separator_bottom_spacing,
  } %}
{% else %}
  {% include '@components/separator/separator-content.twig' with {
    color: separator_color,
    type: separator_type,
    top_spacing: separator_top_spacing,
    bottom_spacing: separator_bottom_spacing,
  } %}
{% endif %}
