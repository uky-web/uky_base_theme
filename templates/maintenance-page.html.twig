{{ page.alert }}
{% include 'components-universal-header' %}

<main class="main" id="main-content">
    {% block main %}
        {% block content_prefix %}
            {{ page.content_prefix }}
        {% endblock %}

        {% block main_content %}
            <div style="
                max-width:60%; 
                margin:3rem auto; 
                padding:2rem; 
                text-align:center;
            ">
                <div class="logos" style="display:flex; justify-content:center; align-items:center; gap:2rem; margin-bottom:1.5rem;">
                    <div class="uk-logo">
                        <img src="/themes/uky_platform/ukd8/assets/static/UK-logo-blue.png" alt="UK Logo" style="height:10rem;">
                    </div>
                </div>

                {% if site_name %}
                    <h1 style="font-size:2rem; margin-bottom:3rem; color:#0033a0; font-weight:700;">{{ site_name }}</h1>
                {% endif %}

                <img src="/themes/uky_platform/ukd8/assets/static/seperator.png" alt="Seperator" style="width:90%; margin: 3rem auto;">

                {% if title %}
                    <h2 style="font-size:1.5rem; margin-bottom:3rem; color:#0033a0; font-weight:400;">{{ title }}</h2>
                {% endif %}

                {% if page.content %}
                    <div class="maintenance-message" style="
                        font-size:1.15rem;
                        color:#333;
                        line-height:1.5;
                    ">
                        {{ page.content }}
                    </div>
                {% endif %}

            </div>
            <br>
            <br>
        {% endblock %}

        {% block content_suffix %}
            {{ page.content_suffix }}
        {% endblock %}
    {% endblock %}
</main>

{% include 'components-universal-footer' %}
