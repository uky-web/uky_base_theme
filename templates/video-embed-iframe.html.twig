{#
/**
 * @file
 * Theme override for video embed field formatter output.
 */
#}
{% set wrapper_attrs = wrapper_attributes is defined ? wrapper_attributes : create_attribute() %}
{% set iframe_attrs = iframe_attributes is defined ? iframe_attributes : (attributes is defined ? attributes : create_attribute()) %}
{% set iframe_src = url is defined ? url : (src is defined ? src : '') %}
{% set effective_title = media_label is defined and media_label ? media_label : (title is defined ? title : '') %}

{% if effective_title and not iframe_attrs.hasAttribute('title') %}
  {% set iframe_attrs = iframe_attrs.setAttribute('title', effective_title) %}
{% endif %}

{# Store media label as data attribute for JS fallback in case server-side doesn't work #}
{% if effective_title and not iframe_attrs.hasAttribute('data-media-title') %}
  {% set iframe_attrs = iframe_attrs.setAttribute('data-media-title', effective_title) %}
{% endif %}

{% if width is defined and width and not iframe_attrs.hasAttribute('width') %}
  {% set iframe_attrs = iframe_attrs.setAttribute('width', width) %}
{% endif %}
{% if height is defined and height and not iframe_attrs.hasAttribute('height') %}
  {% set iframe_attrs = iframe_attrs.setAttribute('height', height) %}
{% endif %}

{% if responsive %}
  <div{{ wrapper_attrs.addClass('video-embed-field-responsive-video') }}{% if effective_title %} data-media-title="{{ effective_title }}"{% endif %}>
    <iframe{{ iframe_attrs }} src="{{ iframe_src }}"></iframe>
  </div>
{% else %}
  <iframe{{ iframe_attrs }} src="{{ iframe_src }}"></iframe>
{% endif %}
